<Window
    
    Icon="Assets/WorkingTimeChecker.ico"
    x:Class="WorkingTimeChecker.Gui.CredentialSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="認証情報設定"
    Width="760"
    Height="720"
    MinWidth="680"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="#F5F7FA">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,4" />
        </Style>

        <Style
            x:Key="StatusTextStyle"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                Text="認証情報設定"
                FontSize="24"
                FontWeight="SemiBold" />

            <TextBlock
                Margin="0,8,0,16"
                Foreground="#555555"
                TextWrapping="Wrap"
                Text="Windows資格情報マネージャーへ保存します。保存済みの値は画面に表示されません。変更する項目だけ入力してください。" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">

            <StackPanel>
                <GroupBox Header="Web勤怠">
                    <StackPanel>
                        <TextBlock
                            x:Name="WebAttendanceStatusText"
                            Style="{StaticResource StatusTextStyle}"
                            Text="状態を確認しています..." />

                        <TextBlock Text="ユーザーID" />
                        <TextBox
                            x:Name="AppsIdTextBox"
                            ToolTip="APPS_ID。空欄の場合は既存値を変更しません。" />

                        <TextBlock Text="パスワード" />
                        <PasswordBox
                            x:Name="AppsPasswordBox"
                            ToolTip="APPS_PASSWORD。空欄の場合は既存値を変更しません。" />
                        <TextBlock
                            x:Name="AppsPasswordStatusText"
                            Margin="0,-6,0,10"
                            Foreground="#177245"
                            FontWeight="SemiBold"
                            Visibility="Collapsed"
                            Text="●●●●●●●●  登録済み。変更する場合のみ入力" />

                        <TextBlock Text="TOTP秘密鍵" />
                        <PasswordBox
                            x:Name="AppsTotpSecretBox"
                            ToolTip="APPS_TOTP_SECRET。空欄の場合は既存値を変更しません。" />
                        <TextBlock
                            x:Name="AppsTotpSecretStatusText"
                            Margin="0,-6,0,10"
                            Foreground="#177245"
                            FontWeight="SemiBold"
                            Visibility="Collapsed"
                            Text="●●●●●●●●  登録済み。変更する場合のみ入力" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Confluence">
                    <StackPanel>
                        <TextBlock
                            x:Name="ConfluenceStatusText"
                            Style="{StaticResource StatusTextStyle}"
                            Text="状態を確認しています..." />

                        <TextBlock
                            Text="dndev ユーザーID" />
                        <TextBox
                            x:Name="DnDevIdTextBox"
                            ToolTip="DNDEV_AWS_ID。空欄の場合は既存値を変更しません。" />

                        <TextBlock
                            Text="dndev パスワード" />
                        <PasswordBox
                            x:Name="DnDevPasswordBox"
                            ToolTip="DNDEV_AWS_PASSWORD。空欄の場合は既存値を変更しません。" />
                        <TextBlock
                            x:Name="DnDevPasswordStatusText"
                            Margin="0,-6,0,10"
                            Foreground="#177245"
                            FontWeight="SemiBold"
                            Visibility="Collapsed"
                            Text="●●●●●●●●  登録済み。変更する場合のみ入力" />

                        <TextBlock
                            Text="geniie ユーザーID" />
                        <TextBox
                            x:Name="GeniieIdTextBox"
                            ToolTip="GENIIE_ID。空欄の場合は既存値を変更しません。" />

                        <TextBlock
                            Text="geniie パスワード" />
                        <PasswordBox
                            x:Name="GeniiePasswordBox"
                            ToolTip="GENIIE_PASSWORD。空欄の場合は既存値を変更しません。" />
                        <TextBlock
                            x:Name="GeniiePasswordStatusText"
                            Margin="0,-6,0,10"
                            Foreground="#177245"
                            FontWeight="SemiBold"
                            Visibility="Collapsed"
                            Text="●●●●●●●●  登録済み。変更する場合のみ入力" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Rocket.Chat">
                    <StackPanel>
                        <TextBlock
                            x:Name="RocketChatStatusText"
                            Style="{StaticResource StatusTextStyle}"
                            Text="状態を確認しています..." />

                        <TextBlock Text="ユーザーID" />
                        <TextBox
                            x:Name="RocketChatUserIdTextBox"
                            ToolTip="ROCKETCHAT_USER_ID。空欄の場合は既存値を変更しません。" />

                        <TextBlock Text="認証トークン" />
                        <PasswordBox
                            x:Name="RocketChatTokenBox"
                            ToolTip="ROCKETCHAT_TOKEN。空欄の場合は既存値を変更しません。" />
                        <TextBlock
                            x:Name="RocketChatTokenStatusText"
                            Margin="0,-6,0,10"
                            Foreground="#177245"
                            FontWeight="SemiBold"
                            Visibility="Collapsed"
                            Text="●●●●●●●●  登録済み。変更する場合のみ入力" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="2"
            Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="MessageText"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="#444444"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">
                <Button
                    Content="登録状態を更新"
                    Click="RefreshButton_Click" />

                <Button
                    Content="保存"
                    IsDefault="True"
                    Click="SaveButton_Click" />

                <Button
                    Content="閉じる"
                    IsCancel="True"
                    Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>