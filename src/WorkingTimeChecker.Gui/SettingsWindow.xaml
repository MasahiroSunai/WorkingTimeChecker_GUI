<Window
    x:Class="WorkingTimeChecker.Gui.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="Assets/WorkingTimeChecker.ico"
    Title="アプリ設定"
    Width="900"
    Height="740"
    MinWidth="760"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    Background="#F3F6F9"
    FontFamily="Yu Gothic UI"
    FontSize="14">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,5" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="#162A3A"
                Text="アプリ設定" />

            <TextBlock
                Margin="0,7,0,14"
                Foreground="#526576"
                TextWrapping="Wrap"
                Text="config.yamlの設定を編集します。保存前にバックアップを作成します。認証情報は「認証情報設定」で管理してください。" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="12"
            Background="White"
            BorderBrush="#DCE3EA"
            BorderThickness="1"
            CornerRadius="8">

            <TabControl x:Name="SettingsTabControl">
                <TabItem Header="基本設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="SystemSettingsPanel"
                            Margin="12" />
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="ファイル">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="PathsSettingsPanel"
                            Margin="12" />
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Confluence">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="ConfluenceSettingsPanel"
                            Margin="12" />
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Web勤怠・通知">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="ServiceSettingsPanel"
                            Margin="12" />
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Selenium詳細設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="SeleniumSettingsPanel"
                            Margin="12" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Grid
            Grid.Row="2"
            Margin="0,14,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="MessageText"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="#526576"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">

                <Button
                    Content="再読み込み"
                    Click="ReloadButton_Click" />

                <Button
                    Content="保存"
                    IsDefault="True"
                    Background="#1976D2"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click" />

                <Button
                    Content="閉じる"
                    IsCancel="True"
                    Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>