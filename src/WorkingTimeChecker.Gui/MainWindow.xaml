<Window Icon="Assets/WorkingTimeChecker.ico"
    x:Class="WorkingTimeChecker.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="工数表 ⇔ Web勤怠 相違チェック"
    Width="1100"
    Height="760"
    MinWidth="900"
    MinHeight="620"
    Background="#F3F6F9"
    FontFamily="Yu Gothic UI"
    FontSize="14"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BorderBrush" Value="#DCE3EA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  タイトル  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="#162A3A"
                Text="工数表 ⇔ Web勤怠 相違チェック" />

            <TextBlock
                Margin="0,5,0,0"
                Foreground="#526576"
                Text="工数集計、Web勤怠取得、相違チェック、通知処理を実行します。" />
        </StackPanel>

        <!--  設定情報  -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="対象年月" />

                <TextBlock
                    x:Name="TargetMonthText"
                    Grid.Column="1"
                    Margin="12,0,28,0"
                    VerticalAlignment="Center"
                    Text="-" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="実行モード" />

                <Border
                    x:Name="DryRunBadge"
                    Grid.Column="3"
                    Margin="12,0,28,0"
                    Padding="12,5"
                    HorizontalAlignment="Left"
                    Background="#FFF3CD"
                    CornerRadius="12">
                    <TextBlock
                        x:Name="DryRunText"
                        FontWeight="SemiBold"
                        Foreground="#795C00"
                        Text="確認中" />
                </Border>

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="実行Runtime" />

                <TextBlock
                    x:Name="ExecutablePathText"
                    Grid.Column="5"
                    Margin="12,0,20,0"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />

                <Button
                    x:Name="ReloadSettingsButton"
                    Grid.Column="6"
                    Click="ReloadSettingsButton_Click"
                    Content="再読み込み" />
            </Grid>
        </Border>

        <!--  ステップ選択  -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="取得・集計" />

                    <CheckBox
                        x:Name="ConfluenceDownloadCheckBox"
                        Content="1. Confluence添付ファイル取得"
                        IsChecked="True"
                        Tag="ConfluenceDownload" />

                    <CheckBox
                        x:Name="ExcelMacroCheckBox"
                        Content="2. 工数表集計（C#）"
                        IsChecked="True"
                        Tag="ExcelMacro" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="勤怠チェック" />

                    <CheckBox
                        x:Name="WebAttendanceDownloadCheckBox"
                        Content="3. Web勤怠取得"
                        IsChecked="True"
                        Tag="WebAttendanceDownload" />

                    <CheckBox
                        x:Name="WorkingTimeCheckerCheckBox"
                        Content="4. 工数・勤怠比較"
                        IsChecked="True"
                        Tag="WorkingTimeChecker" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="通知" />

                    <CheckBox
                        x:Name="CopyConfluenceCheckBox"
                        Content="5. Confluenceコピー"
                        IsChecked="True"
                        Tag="CopyConfluence" />

                    <CheckBox
                        x:Name="PostRocketChatCheckBox"
                        Content="6. Rocket.Chat通知"
                        IsChecked="True"
                        Tag="PostRocketChat" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ログ  -->
        <Border
            Grid.Row="3"
            Margin="0,0,0,14"
            Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="実行ログ" />

                        <TextBlock
                            x:Name="CurrentStepText"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#526576"
                            Text="待機中" />
                    </StackPanel>

                    <Button
                        x:Name="ClearLogButton"
                        Grid.Column="1"
                        Click="ClearLogButton_Click"
                        Content="画面ログをクリア" />
                </Grid>

                <TextBox
                    x:Name="LogTextBox"
                    Grid.Row="1"
                    Padding="12"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    Background="#101820"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="#DCE8F2"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <!--  操作ボタン  -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button
                    x:Name="ValidateButton"
                    Click="ValidateButton_Click"
                    Content="設定を検証" />

                <Button
                    x:Name="RunSelectedButton"
                    Background="#DDEEFF"
                    Click="RunSelectedButton_Click"
                    Content="選択した処理を実行" />

                <Button
                    x:Name="RunAllButton"
                    Background="#1976D2"
                    Click="RunAllButton_Click"
                    Content="すべて実行"
                    FontWeight="SemiBold"
                    Foreground="White" />

                <Button
                    x:Name="CancelButton"
                    Background="#FDE2E2"
                    Click="CancelButton_Click"
                    Content="キャンセル"
                    IsEnabled="False" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    x:Name="OpenLogFolderButton"
                    Click="OpenLogFolderButton_Click"
                    Content="ログフォルダーを開く" />
            </StackPanel>
        </Grid>
    
        <Button
            x:Name="SettingsButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,12,160,0"
            Padding="14,6"
            Panel.ZIndex="100"
            Content="アプリ設定"
            Click="SettingsButton_Click" />

        <Button
            x:Name="CredentialSettingsButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,12,12,0"
            Padding="14,6"
            Panel.ZIndex="100"
            Content="認証情報設定"
            Click="CredentialSettingsButton_Click" /></Grid>
</Window>
